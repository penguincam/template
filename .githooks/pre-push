#!/usr/bin/env bash
# penguincam pre-push hook.
# Refuses: a push to any penguincam remote, and unsigned commits, commits
# with no Signed-off-by line, AI attribution and agent files in the pushed
# range. Warns: branch name without a prefix.
# The pushed range is every commit the destination remote does not hold yet.
set -u

# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

remote_name="${1:-}"
remote_url="${2:-}"

# True for the all-zero object name git uses for a missing ref, in either
# object format (40 hex digits for SHA-1, 64 for SHA-256).
pc_is_null_oid() {
  case "$1" in
    "" | *[!0]*) return 1 ;;
  esac
  return 0
}

# The argument that makes `git rebase` start at the given commit.
pc_rebase_base() {
  if git rev-parse -q --verify "$1~1" >/dev/null; then
    git rev-parse --short "$1~1"
  else
    printf -- '--root\n'
  fi
}

input="$(mktemp "${TMPDIR:-/tmp}/penguincam-pre-push.XXXXXX")"
trap 'rm -f "$input"' EXIT
cat > "$input"

# Only the owner holds write on organization repositories. The owner sets
# PENGUINCAM_HOOKS_ALLOW_ORG_PUSH=1 for such a push. That skips this check
# alone: signatures, sign-offs, attribution and agent files are still checked.
to_org=0
if printf '%s\n' "$remote_url" | grep -iqE "$PC_ORG_REMOTE_RE"; then
  to_org=1
  if [ "${PENGUINCAM_HOOKS_ALLOW_ORG_PUSH:-}" != 1 ]; then
    pc_refuse "push to the organization remote '$remote_name' ($remote_url); work lands only through a pull request from your fork" \
      "Fork first" \
      "git push origin HEAD && git config remote.pushDefault origin   # then open the pull request from your fork"
    exit 1
  fi
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  if pc_is_null_oid "$local_sha"; then continue; fi

  overlay=0
  case "$remote_ref" in
    refs/heads/*)
      branch="${remote_ref#refs/heads/}"
      case "$branch" in
        main | dev) ;;
        "$PC_OVERLAY_BRANCH") overlay=1 ;;
        *)
          if ! printf '%s\n' "$branch" | grep -qE '^(feat|fix|docs|chore)/[a-z0-9][a-z0-9.-]*$'; then
            pc_warn "branch '$branch' has no prefix (feat/ fix/ docs/ chore/) and kebab-case slug" \
              "Branches" \
              "git branch -m '${local_ref#refs/heads/}' feat/short-slug && git push origin feat/short-slug"
          fi
          ;;
      esac
      ;;
  esac

  # Commits the destination already holds, as its remote-tracking refs show,
  # are skipped. Commits held only by another remote, such as an archive,
  # are walked. The destination's overlay branch does not count as held, so
  # overlay commits merged into another branch are walked too. A push to a
  # bare URL has no remote-tracking refs, so the whole history is walked.
  exclude=(--not "--exclude=$remote_name/$PC_OVERLAY_BRANCH" "--remotes=$remote_name")
  if ! pc_is_null_oid "$remote_sha" && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    exclude+=("$remote_sha")
  fi

  commits="$(git rev-list "$local_sha" "${exclude[@]}" 2>/dev/null || true)"

  unsigned=""
  oldest_unsigned=""
  unsigned_off=""
  oldest_unsigned_off=""
  for sha in $commits; do
    raw="$(git cat-file commit "$sha")"
    header="$(printf '%s\n' "$raw" | sed '/^$/q')"
    message="$(printf '%s\n' "$raw" | sed '1,/^$/d')"
    short="$(git rev-parse --short "$sha")"

    # Merge commits made by GitHub are exempt from the signature and the
    # sign-off rules.
    github_merge=0
    parents="$(printf '%s\n' "$header" | grep -c '^parent ')"
    if [ "$parents" -gt 1 ] && printf '%s\n' "$header" | grep -qE '^committer GitHub <noreply@github\.com> '; then
      github_merge=1
    fi

    signed=0
    if printf '%s\n' "$header" | grep -qE '^gpgsig(-sha256)? '; then signed=1; fi
    signed_off=0
    if printf '%s\n' "$message" | pc_has_signoff; then signed_off=1; fi

    if [ "$signed" -eq 0 ] && [ "$github_merge" -eq 0 ]; then
      unsigned="$short${unsigned:+ $unsigned}"
      oldest_unsigned="$sha"
    fi

    if [ "$signed_off" -eq 0 ] && [ "$github_merge" -eq 0 ]; then
      unsigned_off="$short${unsigned_off:+ $unsigned_off}"
      oldest_unsigned_off="$sha"
    fi

    if line="$(printf '%s\n' "$message" | pc_ai_attribution_line)"; then
      pc_refuse "commit $short carries AI attribution: $line" \
        "Commits" \
        "git rebase -i $(pc_rebase_base "$sha")   # mark $short as reword, delete that line, then git push origin HEAD --force-with-lease"
    fi
  done

  if [ -n "$oldest_unsigned" ]; then
    pc_refuse "unsigned commits in the pushed range: $unsigned" \
      "Commits" \
      "git config commit.gpgsign true && git rebase --force-rebase --gpg-sign $(pc_rebase_base "$oldest_unsigned") && git push origin HEAD --force-with-lease   # if these commits are upstream's, run gh repo sync and git fetch origin first, and do not rebase them"
  fi

  if [ -n "$oldest_unsigned_off" ]; then
    pc_refuse "commits with no Signed-off-by line in the pushed range: $unsigned_off" \
      "Sign off every commit" \
      "git rebase --force-rebase --signoff --gpg-sign $(pc_rebase_base "$oldest_unsigned_off") && git push origin HEAD --force-with-lease   # if these commits are upstream's, run gh repo sync and git fetch origin first, and do not rebase them"
  fi

  # Agent files: refused in every commit of the range and in the pushed tree.
  # The overlay branch may carry them, but only to a fork.
  if [ "$overlay" -eq 1 ] && [ "$to_org" -eq 0 ]; then
    continue
  fi
  agent="$(
    {
      for sha in $commits; do
        git -c core.quotePath=false diff-tree -r --no-commit-id --name-only --diff-filter=AMRC --root "$sha" 2>/dev/null
      done
      git -c core.quotePath=false ls-tree -r --name-only "$local_sha" 2>/dev/null
    } | pc_agent_paths
  )"
  if [ -n "$agent" ]; then
    first="$(printf '%s\n' "$agent" | sed -n 1p)"
    pc_refuse "agent files in the pushed range of ${remote_ref}: $(printf '%s\n' "$agent" | tr '\n' ' ')" \
      "Agent files" \
      "git rm -r --cached -- '$first' && printf '/%s\\n' '$first' >> \"\$(git rev-parse --git-common-dir)/info/exclude\"   # then drop it from every pushed commit with git rebase -i and push again"
  fi
done < "$input"

if [ "$PC_REFUSED" -ne 0 ]; then
  exit 1
fi

pc_chain pre-push "$input" "$remote_name" "$remote_url"
